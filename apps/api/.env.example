# Copy to apps/api/.env for local API settings; values here are placeholders only.
TRACKER_HOST=127.0.0.1
TRACKER_API_PORT=4174
DATABASE_URL=postgresql://tracker_local:local-dev-only-change-me@127.0.0.1:5433/finntech_tracker
# Auth is dormant unless these server-only values are configured together.
BETTER_AUTH_SECRET=<RANDOM_SERVER_ONLY_SECRET_AT_LEAST_32_CHARACTERS>
TRACKER_ORIGIN=http://127.0.0.1:4173

# Optional Alpaca Basic IEX: keep blank until the owner supplies their own free keys.
# Never put these in VITE_* variables. Configure all four values together.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_OWNER_ID=
ALPACA_PERSONAL_USE=
# Example watchlist only; these are not holdings and do not grant market-data access.
# ALPACA_SYMBOLS=AAPL,MSFT,NVDA,SPY
# Unset ALPACA_SYMBOLS uses the 30-symbol starter watchlist.
