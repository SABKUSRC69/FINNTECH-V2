+@font-face {
+  font-family: 'Noto Local';
+  src: url('/fonts/NotoSansThai.ttf') format('truetype');
+  font-weight: 100 900;
+  font-display: swap;
+}
+
+:root { font-family: 'Noto Local', 'Leelawadee UI', Tahoma, system-ui, sans-serif; background: #f4f0e8; color-scheme: light; }
+body { margin: 0; min-width: 0; }
+.tracker-app {
+  --canvas: #f4f0e8; --surface: #fffcf7; --surface-muted: #ece7dc;
+  --ink: #343b3b; --muted: #686b62; --line: #d9d3c7;
+  --accent: #98533e; --accent-ink: #fff; --accent-soft: #f2e4d9;
+  --positive: #45634e; --negative: #9b3542; --warning: #7e501a; --warning-bg: #fff0d7;
+  --space-page: 48px; --radius: 5px;
+  background: var(--canvas); color: var(--ink); line-height: 1.75;
+}
+.tracker-app[data-theme='dark'] {
+  --canvas: #242620; --surface: #30332b; --surface-muted: #383c32;
+  --ink: #f1eee6; --muted: #bdc1b4; --line: #4c5143;
+  --accent: #e1ab8d; --accent-ink: #36271e; --accent-soft: #42352b;
+  --positive: #a2d1af; --negative: #f0adb2; --warning: #efc58a; --warning-bg: #413321;
+  color-scheme: dark;
+}
+.tracker-app[data-theme] { color: var(--ink); }
+.tracker-app :is(.bg-white, .tracker-card) { background: var(--surface); }
+.tracker-app :is(.bg-slate-100, .bg-slate-50) { background: var(--surface-muted); }
+.tracker-app :is(.text-slate-900, .text-slate-800, .text-slate-700) { color: var(--ink); }
+.tracker-app :is(.text-slate-600, .text-slate-500, .text-slate-400) { color: var(--muted); }
+.tracker-app :is(.border-slate-100, .border-slate-200, .border-slate-300, .border-slate-200\/80) { border-color: var(--line); }
+.tracker-app :is(.text-teal-700, .text-teal-800) { color: var(--positive); }
+.tracker-app .text-rose-700 { color: var(--negative); }
+.tracker-app .text-amber-900 { color: var(--warning); }
+.tracker-app .bg-amber-50 { background: var(--warning-bg); }
+.tracker-app :is(.border-rose-200, .border-amber-200, .border-teal-200) { border-color: var(--line); }
+.tracker-app .bg-teal-50 { background: var(--accent-soft); }
+.tracker-app button, .tracker-app a { touch-action: manipulation; }
+.tracker-app button { min-height: 44px; }
+.tracker-app button:disabled { cursor: not-allowed; opacity: .6; }
+.tracker-app :is(button, a, input, select):focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
+.tracker-app :is(h1, h2, h3, h4, p, label) { overflow-wrap: anywhere; }
+.tracker-app :is(h2, h3) { font-weight: 550; letter-spacing: -.02em; }
+.tracker-app .tracker-card { min-width: 0; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: none; }
+.tracker-app .auth-input { min-width: 0; border-color: var(--line); color: var(--ink); background: var(--surface); border-radius: var(--radius); font-size: 16px; padding: 11px 14px; }
+.tracker-app .auth-input:focus { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
+.tracker-app .auth-input:disabled { background: var(--surface-muted); color: var(--muted); }
+.tracker-app .auth-label { color: var(--ink); min-width: 0; font-weight: 500; }
+.tracker-app .auth-primary { background: var(--accent); color: var(--accent-ink); min-height: 46px; border-radius: var(--radius); font-weight: 550; }
+.tracker-app .auth-primary:hover:not(:disabled) { filter: brightness(.93); }
+.tracker-app .auth-primary:disabled { background: var(--surface-muted); color: var(--muted); }
+.tracker-app .auth-secondary { border-color: var(--line); color: var(--ink); background: transparent; border-radius: var(--radius); }
+.tracker-app .auth-secondary:hover:not(:disabled) { background: var(--surface-muted); }
+.tracker-icon { width: 20px; height: 20px; flex: 0 0 20px; }
+.tracker-app .tracker-header { border: 0; background: var(--canvas); }
+.tracker-header-inner { max-width: 1500px; margin: auto; min-height: 92px; }
+.tracker-brand { font-size: 16px; }
+.tracker-brand .journal-mark { background: transparent; color: var(--ink); border-radius: 0; font-size: 32px; font-weight: 650; width: 44px; }
+.journal-mark::after { content: '.'; color: var(--accent); }
+.journal-brand-subtitle { display: block; font-size: 9px; letter-spacing: .12em; color: var(--muted); font-weight: 400; }
+.tracker-display-controls { display: flex; gap: 8px; }
+.tracker-icon-button { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: var(--radius); color: var(--muted); background: var(--surface); }
+.tracker-icon-button:hover, .tracker-icon-button[aria-pressed='true'] { background: var(--accent-soft); color: var(--accent); }
+.tracker-app .tracker-local-badge { border: 0; border-radius: 0; background: transparent; color: var(--muted); font-size: 11px; }
+.tracker-layout { display: grid; grid-template-columns: 92px minmax(0, 1fr); max-width: 1500px; margin: auto; }
+.tracker-nav { padding: 24px 14px; border-right: 1px solid var(--line); position: sticky; top: 20px; align-self: start; }
+.tracker-nav-heading, .tracker-nav-note { display: none; }
+.tracker-nav-item { width: 100%; min-height: 48px; display: flex; align-items: center; gap: 12px; color: var(--muted); padding: 12px; margin: 6px 0; text-align: left; font-size: 14px; border-radius: var(--radius); }
+.tracker-nav > .tracker-nav-item { width: 52px; height: 52px; justify-content: center; margin: 8px auto; border-radius: 50%; }
+.tracker-nav > .tracker-nav-item span { position: absolute; width: 1px; height: 1px; clip-path: inset(50%); overflow: hidden; }
