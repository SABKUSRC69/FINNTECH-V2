diff --git a/apps/web/src/tracker/useValuationReferences.ts b/apps/web/src/tracker/useValuationReferences.ts
new file mode 100644
index 0000000..d41020d
--- /dev/null
+++ b/apps/web/src/tracker/useValuationReferences.ts
@@ -0,0 +1,90 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { dailyCloseSnapshotSchema, valuationOverviewSchema, type ValuationOverview } from '@finntech/contracts'
+import { trackerRequest, TrackerRequestError } from './client'
+
+const RETRY_MS = 30 * 60000
+const identity = (value: ValuationOverview | null) => {
+  const daily = value?.dailyCloses
+  return daily?.retention === 'TRANSIENT'
+    ? [daily.keySource, daily.keyVersion, daily.expectedSession, ...daily.quotes.map(q => q.symbol)].join(':') : null
+}
+
+/** Personal closes are held only by this mounted, visible calculation view. No browser storage,
+ * global store, completed-response cache or historical valuation contains provider prices.
+ */
+export function useValuationReferences(expired: () => void) {
+  const [overview, setOverview] = useState<ValuationOverview | null>(null)
+  const [reading, setReading] = useState(false)
+  const current = useRef<ValuationOverview | null>(null), active = useRef(true), generation = useRef(0)
+  const pending = useRef<Promise<void> | null>(null), nextRead = useRef(0), onExpired = useRef(expired)
+  onExpired.current = expired
+  const load = useCallback((force = false): Promise<void> => {
+    if (!active.current || document.visibilityState === 'hidden') return Promise.resolve()
+    if (pending.current) return pending.current
+    setReading(true)
+    const operation = generation.current
+    const publish = (value: ValuationOverview | null) => {
+      if (active.current && operation === generation.current && document.visibilityState !== 'hidden') {
+        current.current = value; setOverview(value)
+      }
+    }
+    const flight = (async () => {
+      try {
+        const metadata = valuationOverviewSchema.parse(await trackerRequest('valuation/references'))
+        if (!active.current || operation !== generation.current || document.visibilityState === 'hidden') return
+        if (metadata.dailyCloses?.retention !== 'TRANSIENT') { publish(metadata); return }
+        const same = identity(current.current) === identity(metadata)
+        if (!force && same && Date.now() < nextRead.current) {
+          // Metadata reconciles every 15 s without spending a price request. Keep only this view's
+          // current calculation inputs; key removal/version changes discard them immediately.
+          publish({ ...metadata, dailyCloses: { ...metadata.dailyCloses, quotes: current.current!.dailyCloses!.quotes } })
+          return
+        }
+        // Retire the previous calculation before starting another provider read.
+        publish(metadata); nextRead.current = Date.now() + RETRY_MS
+        if (!metadata.dailyCloses.quotes.length) return
+        try {
+          const daily = dailyCloseSnapshotSchema.parse(await trackerRequest('valuation/daily-close', 'GET', undefined, undefined, 20000))
+          publish({ ...metadata, dailyCloses: daily })
+        } catch (error) {
+          publish({ ...metadata, dailyCloses: { ...metadata.dailyCloses,
+            quotes: metadata.dailyCloses.quotes.map(q => ({ ...q, status: 'ERROR', problem: 'UNAVAILABLE' })) } })
+          if (error instanceof TrackerRequestError && error.expired) { publish(null); onExpired.current() }
+        }
+      } catch (error) {
+        publish(null)
+        if (error instanceof TrackerRequestError && error.expired) onExpired.current()
+      }
+    })()
+    pending.current = flight
+    void flight.finally(() => { if (pending.current === flight) pending.current = null; if (active.current) setReading(false) })
+    return flight
+  }, [])
+
+  useEffect(() => {
+    active.current = true
+    const previous = pending.current
+    if (previous) void previous.then(() => load()); else void load()
+    const visibility = () => {
+      if (document.visibilityState === 'hidden') { generation.current++; current.current = null; setOverview(null); nextRead.current = 0 }
+      else {
+        const old = pending.current
+        if (old) void old.then(() => load(true)); else void load(true)
+      }
+    }
+    const pageHide = () => { generation.current++; current.current = null; setOverview(null); nextRead.current = 0 }
+    document.addEventListener('visibilitychange', visibility)
+    window.addEventListener('pagehide', pageHide)
+    window.addEventListener('pageshow', visibility)
+    // The stock view has no 15 s reconciliation of its own. This checks only metadata until a
+    // publication date changes or 30 minutes pass (also catches evening exchange corrections).
+    const timer = setInterval(() => { void load() }, 60000)
+    return () => {
+      active.current = false; generation.current++; current.current = null; nextRead.current = 0
+      document.removeEventListener('visibilitychange', visibility)
+      window.removeEventListener('pagehide', pageHide); window.removeEventListener('pageshow', visibility)
+      clearInterval(timer)
+    }
+  }, [load])
+  return { overview, load, reading }
+}
