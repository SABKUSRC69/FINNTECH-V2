+export default function RealUseNotice({ supportEmail }: { supportEmail?: string | undefined }): JSX.Element {
+  return <details className="tracker-card mx-auto my-5 max-w-6xl px-5 py-4 text-sm leading-7" aria-label="ความเป็นส่วนตัวและเงื่อนไขการใช้">
+    <summary className="cursor-pointer font-semibold">ความเป็นส่วนตัวและเงื่อนไขการใช้ FINNTECH</summary>
+    <div className="mt-3 space-y-3">
+      <p>ใช้บันทึกการเงินด้วยตนเอง ไม่มีการซื้อขาย ฝากถอน เครดิต หรือคำแนะนำการลงทุน ยืนยันอีเมลก่อนเข้าใช้ เริ่มด้วยรายการว่าง ข้อมูลผูกกับบัญชีและคงอยู่หลังออกจากระบบ ส่วน DEMO อยู่คนละฐานและไม่นำมาเป็นข้อมูลจริง</p>
+      <p>ระบบเก็บชื่อ อีเมล hash รหัสผ่าน sessions และรายการที่คุณกรอกเพื่อแสดงผล คำนวณ ตรวจสิทธิ์ และป้องกันรายการซ้ำ การยืนยันอีเมลไม่ใช่ KYC ผู้ดูแลระบบมีสิทธิ์ดูแลฐาน ข้อมูลบัญชีและบันทึกส่วนตัวไม่ได้เข้ารหัสแยกจากผู้ดูแล</p>
+      <p>โฮสต์และฐานข้อมูลใช้ Render/Neon; Brevo รับอีเมลและลิงก์ยืนยัน/กู้คืน; Google Drive ของผู้ดูแลใช้เก็บสำรองที่เข้ารหัส ผู้ให้บริการอาจประมวลผลข้อมูลในต่างประเทศ ไม่ส่งบันทึกการเงินให้อีเมล provider และไม่ส่ง key ถอดรหัสไปพร้อมไฟล์สำรอง</p>
+      <p>Sessions อายุสูงสุด 7 วัน ลิงก์ reset 15 นาที ลิงก์ยืนยันอีเมล 24 ชั่วโมง ต้องกดยืนยันเองและใช้ได้ครั้งเดียว Reset เพิกถอน sessions เดิมทั้งหมด ข้อมูลการเงินเก็บจนมีคำขอลบที่ตรวจเจ้าของแล้ว ยังไม่มีปุ่มลบบัญชีด้วยตนเอง ติดต่อผู้ดูแลเพื่อส่งออกและเริ่มกระบวนการลบ อย่าส่งรหัสผ่านหรือลิงก์กู้คืนให้ผู้ดูแล</p>
+      <p>JSON ที่ดาวน์โหลดไม่เข้ารหัสและมีบันทึกส่วนตัว เก็บในที่ส่วนตัวและลบสำเนาที่ไม่ต้องการ ผู้ดูแลลบสำเนาจากเครื่องของคุณไม่ได้ สำเนาฐานข้อมูลมีนโยบายอายุแยกและต้องตรวจการลบทุกชุดก่อนยืนยันคำขอลบเสร็จ</p>
+      <p>บริการงบศูนย์อาจพักเมื่อไม่ใช้งาน หยุดเมื่อโควตาหมด และไม่มี SLA เก็บไฟล์ส่งออกของตนเองด้วย เมื่อคำขอค้าง ให้ตรวจผลด้วย payload/key เดิมก่อนส่งใหม่ ราคาเกิน 30 วินาทีไม่ใช้คำนวณปัจจุบัน</p>
+      <p>ติดต่อผู้ดูแล: <span className="break-all">{supportEmail ?? 'ยังไม่ได้กำหนดช่องทาง — ยังไม่เปิดรับข้อมูลจริง'}</span></p>
+    </div>
+  </details>
+}
