+  await assert.rejects(assertRealBoundary(db, { ...config.real!, databaseRole: 'beta_app' }, origin))
+  for (const path of ['me', 'finance?month=2026-10', 'crypto', 'backup']) assert.equal((await get(path)).status, 401)
