diff --git a/scripts/real-backup-watchdog.mjs b/scripts/real-backup-watchdog.mjs
new file mode 100644
index 0000000..3986d9b
--- /dev/null
+++ b/scripts/real-backup-watchdog.mjs
@@ -0,0 +1,45 @@
+import { createHash } from 'node:crypto'
+import { backupFreshness } from './real-backup-core.mjs'
+import { GoogleDriveBackups } from './real-drive-backup-core.mjs'
+
+// Must run OUTSIDE the Windows backup computer and outside the sleeping Render service.
+// It reads an authenticated off-device receipt, never the archive or encryption key.
+const url = new URL(process.env.FINNTECH_BACKUP_RECEIPT_URL ?? 'https://invalid.invalid')
+if (!process.env.FINNTECH_DRIVE_RECEIPT_FILE_ID && (url.protocol !== 'https:' || url.username || url.password || url.search || url.hash || url.hostname === 'invalid.invalid'
+  || !process.env.FINNTECH_BACKUP_RECEIPT_READ_TOKEN)) throw new Error('WATCHDOG_CONFIGURATION_REQUIRED')
+let receipt
+try {
+  if (process.env.FINNTECH_DRIVE_RECEIPT_FILE_ID) {
+    const drive = new GoogleDriveBackups({ clientId: process.env.FINNTECH_DRIVE_CLIENT_ID, clientSecret: process.env.FINNTECH_DRIVE_CLIENT_SECRET, refreshToken: process.env.FINNTECH_DRIVE_REFRESH_TOKEN })
+    await drive.authenticate()
+    try { receipt = JSON.parse((await drive.download(process.env.FINNTECH_DRIVE_RECEIPT_FILE_ID, 4096)).toString('utf8')) }
+    finally { drive.token = undefined }
+  } else {
+  const response = await fetch(url, { redirect: 'error', signal: AbortSignal.timeout(5000),
+    headers: { authorization: `Bearer ${process.env.FINNTECH_BACKUP_RECEIPT_READ_TOKEN}`, 'cache-control': 'no-cache' } })
+  if (!response.ok) throw new Error('receipt_unavailable')
+  const reader = response.body.getReader(); let bytes = 0; const chunks = []
+  try { while (true) { const item = await reader.read(); if (item.done) break; bytes += item.value.length; if (bytes > 4096) throw new Error('receipt_limit'); chunks.push(item.value) } }
+  finally { void reader.cancel().catch(() => {}) }
+  receipt = JSON.parse(Buffer.concat(chunks).toString('utf8'))
+  }
+} catch { /* Missing/offline/failed publication triggers the same alert. */ }
+if (backupFreshness(receipt) === 'CURRENT' && (!process.env.FINNTECH_DRIVE_RECEIPT_FILE_ID || receipt.offDeviceCopy === 'DOWNLOADED_AND_AUTHENTICATED')) console.log('PASS: last published encrypted backup is within 24 hours; restore readiness assessed separately')
+else {
+  const sender = process.env.TRACKER_MAIL_SENDER ?? '', recipient = process.env.FINNTECH_BACKUP_ALERT_EMAIL ?? '', key = process.env.TRACKER_MAIL_API_KEY ?? ''
+  if (!/^[^@\s<>]+@[^@\s<>]+\.[^@\s<>]+$/.test(sender) || !/^[^@\s<>]+@[^@\s<>]+\.[^@\s<>]+$/.test(recipient) || key.length < 32) {
+    console.error('FAIL: missed backup; alert channel not configured'); process.exitCode = 2
+  } else {
+    try {
+      const id = createHash('sha256').update(`backup-alert:${new Date().toISOString().slice(0, 10)}:${url.origin}`).digest('hex').slice(0, 32)
+      const response = await fetch('https://api.brevo.com/v3/smtp/email', { method: 'POST', redirect: 'error', signal: AbortSignal.timeout(5000),
+        headers: { 'api-key': key, 'content-type': 'application/json' },
+        body: JSON.stringify({ sender: { name: 'FINNTECH backup monitor', email: sender }, to: [{ email: recipient }],
+          subject: 'FINNTECH — ต้องตรวจสำรองฐานข้อมูล', textContent: 'ไม่พบหลักฐานสำรองเข้ารหัสสำเร็จภายใน 24 ชั่วโมง เครื่องสำรองอาจปิด งานอาจล้มเหลว หรือยังไม่ได้เผยแพร่ receipt กรุณาตรวจด้วยตนเอง ระบบไม่ได้ล้างข้อมูลหรือเปิดรับสมัครแทนคุณ', headers: { 'Idempotency-Key': id } }) })
+      void response.body?.cancel()
+      if (response.status !== 201) throw new Error('alert_unconfirmed')
+      console.log('ALERT_ACCEPTED: missed backup notification accepted by provider; mailbox delivery still requires acceptance')
+      process.exitCode = 1
+    } catch { console.error('FAIL: missed backup and alert delivery unconfirmed; details withheld'); process.exitCode = 2 }
+  }
+}
diff --git a/scripts/real-db-backup.mjs b/scripts/real-db-backup.mjs
