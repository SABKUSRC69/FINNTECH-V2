@@ -0,0 +1,25 @@
+FROM node:22-bookworm-slim AS build
+WORKDIR /app
+COPY package.json package-lock.json tsconfig.tracker.base.json ./
+COPY apps/api ./apps/api
+COPY apps/web ./apps/web
+COPY packages ./packages
+COPY scripts/beta-runtime-dependencies.mjs ./scripts/beta-runtime-dependencies.mjs
+RUN npm ci && npm run tracker:build && node scripts/beta-runtime-dependencies.mjs
+
+FROM node:22-bookworm-slim AS runtime
+WORKDIR /app
+ENV NODE_ENV=production WEB_DIST_DIR=/app/apps/web/dist TRACKER_RUNTIME_MODE=cloud-real
+COPY --from=build /app/beta-runtime-deps/node_modules ./node_modules
+COPY --from=build /app/beta-runtime-deps/apps/api/node_modules ./apps/api/node_modules
+COPY --from=build /app/beta-runtime-deps/inventory.json ./runtime-dependencies.json
+COPY --from=build /app/apps/api/package.json ./apps/api/package.json
+COPY --from=build /app/apps/api/dist ./apps/api/dist
+COPY --from=build /app/apps/web/package.json ./apps/web/package.json
+COPY --from=build /app/apps/web/dist ./apps/web/dist
+COPY --from=build /app/packages/finance/package.json ./packages/finance/package.json
+COPY --from=build /app/packages/finance/dist ./packages/finance/dist
+COPY --from=build /app/packages/contracts/package.json ./packages/contracts/package.json
+COPY --from=build /app/packages/contracts/dist ./packages/contracts/dist
+USER node
+CMD ["node", "apps/api/dist/server.js"]
