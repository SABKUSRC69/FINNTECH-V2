+    allPublicTablesAndConstraintsMatched: true, exactCastRewriteWhitelist: ['delivery_kind', 'delivery_status'], constraintBehaviorMatched: true,
+    sourceUnchanged: true, plaintextDiskFiles: false, targetNetwork: 'none',
+    tableCount: before.split('\n').filter(line => line.startsWith('TABLE:')).length, evidenceSha256: sha256(before),
+    physicalOffDeviceCopy: 'NOT_TESTED', actualSchedule: 'NOT_TESTED', actualAlerts: 'NOT_TESTED', productionRPO: 'NOT_TESTED', productionRTO: 'NOT_TESTED' }
+  await writeFile(path.join(root, 'result.json'), JSON.stringify(result, null, 2))
+  await writeFile(path.join(root, 'source-before.evidence.txt'), before); await writeFile(path.join(root, 'source-after.evidence.txt'), after); await writeFile(path.join(root, 'restored.evidence.txt'), restored)
+  console.log(JSON.stringify(result))
+} catch (error) { console.error(`FAIL: ${error instanceof Error && /^[A-Z_]+$/.test(error.message) ? error.message : 'RESTORE_UNAVAILABLE'}; details withheld; all databases and archives retained`); process.exitCode = 1 }
+finally {
+  key?.fill(0); dump?.fill(0); restoredDump?.fill(0)
+  if (started) { try { await tool([...compose, 'stop', targetService]) } catch { console.error('FAIL: own restore process stop unconfirmed'); process.exitCode = 1 } }
+  await db.$disconnect()
+}
diff --git a/scripts/real-backup-scheduled.ps1 b/scripts/real-backup-scheduled.ps1
new file mode 100644
index 0000000..607dddb
--- /dev/null
+++ b/scripts/real-backup-scheduled.ps1
@@ -0,0 +1,40 @@
+param([Parameter(Mandatory=$true)][string]$PrivateEnvFile)
+$ErrorActionPreference = 'Stop'
+# Review-only operator wrapper. This file does not install a scheduled task.
+# Run under the owner's account after ACL, Drive and full-restore acceptance.
+$taskRepo = Split-Path -Parent $PSScriptRoot
+$taskChanged = @{}
+$taskExit = 1
+try {
+    $taskEnvPath = (Resolve-Path -LiteralPath $PrivateEnvFile).Path
+    if ((Get-Item -LiteralPath $taskEnvPath).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'PRIVATE_ENV_REQUIRED' }
+    foreach ($taskLine in [IO.File]::ReadAllLines($taskEnvPath)) {
+        if ($taskLine -match '^\s*(#|$)') { continue }
+        if ($taskLine -notmatch '^([A-Z][A-Z0-9_]*)=(.*)$') { throw 'PRIVATE_ENV_FORMAT_REJECTED' }
+        $taskName = $Matches[1]; $taskValue = $Matches[2]
+        if ($taskName -notmatch '^(FINNTECH_(BACKUP|DRIVE)_[A-Z0-9_]+|TRACKER_(REAL_DATABASE_(HOST|NAME|ROLE)|ORIGIN))$') { throw 'UNEXPECTED_ENV_NAME' }
+        if ($taskChanged.ContainsKey($taskName)) { throw 'DUPLICATE_ENV_NAME' }
+        $taskChanged[$taskName] = [Environment]::GetEnvironmentVariable($taskName, 'Process')
+        [Environment]::SetEnvironmentVariable($taskName, $taskValue, 'Process')
+    }
+    if (-not $env:FINNTECH_BACKUP_LAST_RECEIPT_FILE -or -not $env:FINNTECH_DRIVE_RECEIPT_FILE_ID) { throw 'SCHEDULE_RECEIPT_REQUIRED' }
+    Push-Location -LiteralPath $taskRepo
+    try {
+        & node --no-strip-types scripts/real-db-backup.mjs
+        if ($LASTEXITCODE -ne 0) { throw 'LOCAL_BACKUP_UNCONFIRMED' }
+        $taskReceipt = Get-Content -LiteralPath $env:FINNTECH_BACKUP_LAST_RECEIPT_FILE -Raw | ConvertFrom-Json
+        $taskAge = ((Get-Date).ToUniversalTime() - [DateTime]::Parse($taskReceipt.createdAt).ToUniversalTime()).TotalMinutes
+        if ($taskReceipt.status -ne 'ENCRYPTED_AND_VERIFIED' -or $taskAge -lt 0 -or $taskAge -gt 10) { throw 'RECENT_BACKUP_REQUIRED' }
+        if (-not $taskChanged.ContainsKey('FINNTECH_BACKUP_ARCHIVE')) { $taskChanged['FINNTECH_BACKUP_ARCHIVE'] = [Environment]::GetEnvironmentVariable('FINNTECH_BACKUP_ARCHIVE', 'Process') }
+        $env:FINNTECH_BACKUP_ARCHIVE = $taskReceipt.archivePath
+        & node scripts/real-drive-backup.mjs
+        if ($LASTEXITCODE -ne 0) { throw 'OFF_DEVICE_BACKUP_UNCONFIRMED' }
+        $taskExit = 0
+    } finally { Pop-Location }
+} catch {
+    # PowerShell's default exceptions can include connection strings; suppress them.
+    Write-Output 'FAIL: scheduled backup unconfirmed; inspect private setup; existing data retained'
+} finally {
+    foreach ($taskName in $taskChanged.Keys) { [Environment]::SetEnvironmentVariable($taskName, $taskChanged[$taskName], 'Process') }
+}
+exit $taskExit
