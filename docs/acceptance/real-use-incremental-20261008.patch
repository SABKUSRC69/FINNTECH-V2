+++ b/scripts/real-db-backup.mjs
@@ -0,0 +1,47 @@
+import { spawn } from 'node:child_process'
+import path from 'node:path'
+import { writeFile } from 'node:fs/promises'
+import { readRealBackupTarget } from './real-backup-target.mjs'
+import { createTrackerDatabase } from '../apps/api/dist/persistence/database.js'
+import { readBackupKey, saveEncryptedBackup, backupLimits } from './real-backup-core.mjs'
+
+// Operator process, never an API route or web-service job. No source mutation.
+const config = readRealBackupTarget(process.env)
+const directory = process.env.FINNTECH_BACKUP_DIRECTORY ?? '', keyPath = process.env.FINNTECH_BACKUP_KEY_FILE ?? ''
+if (!path.isAbsolute(directory) || !path.isAbsolute(keyPath) || path.resolve(keyPath).startsWith(`${path.resolve(directory)}${path.sep}`)
+  || process.env.FINNTECH_BACKUP_PRIVATE_DIRECTORY_CONFIRMED !== 'owner-only') throw new Error('BACKUP_REQUIRES_SEPARATE_PRIVATE_KEY_CUSTODY')
+const db = createTrackerDatabase(config.url.href)
+let key, dump
+try {
+  const current = await db.$queryRaw`SELECT current_database() AS name,current_user AS role`
+  const marker = await db.runtimeBoundary.findUnique({ where: { id: 'singleton' } })
+  if (current[0]?.name !== config.name || current[0]?.role !== config.backupRole || marker?.mode !== 'real'
+    || marker.databaseName !== config.name || marker.databaseRole !== config.appRole || marker.origin !== config.origin
+    || await db.demoWorkspace.count()) throw new Error('BACKUP_DATABASE_BOUNDARY_REJECTED')
+  const version = await db.$queryRaw`SELECT current_setting('server_version_num') AS version`
+  if (Number(version[0]?.version) < 160000 || Number(version[0]?.version) >= 190000) throw new Error('BACKUP_CLIENT_VERSION_REJECTED')
+  key = await readBackupKey(keyPath)
+  const url = config.url
+  const environment = { ...process.env, PGHOST: url.hostname, PGPORT: url.port || '5432', PGDATABASE: config.name,
+    PGUSER: config.backupRole, PGPASSWORD: decodeURIComponent(url.password), PGSSLMODE: 'verify-full', PGSSLROOTCERT: 'system' }
+  const args = ['run', '--rm', '--read-only', '--tmpfs', '/tmp:rw,noexec,nosuid,size=8m', '--cap-drop', 'ALL', '--security-opt', 'no-new-privileges', '--user', 'postgres',
+    ...['PGHOST', 'PGPORT', 'PGDATABASE', 'PGUSER', 'PGPASSWORD', 'PGSSLMODE', 'PGSSLROOTCERT'].flatMap(name => ['--env', name]),
+    'postgres:18-alpine', 'pg_dump', '--format=custom', '--no-owner', '--no-acl', '--lock-wait-timeout=5000']
+  dump = await new Promise((resolve, reject) => {
+    const child = spawn('docker', args, { env: environment, windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'] }), chunks = []; let size = 0
+    const timer = setTimeout(() => { child.kill(); reject(new Error('BACKUP_TIMEOUT')) }, 120000)
+    child.stdout.on('data', chunk => { size += chunk.length; if (size > backupLimits.maximum) { child.kill(); reject(new Error('BACKUP_SIZE_LIMIT')) } else chunks.push(chunk) })
+    child.stderr.on('data', () => {}) // Driver output can contain secrets. Never forward it.
+    child.on('error', () => { clearTimeout(timer); reject(new Error('BACKUP_TOOL_UNAVAILABLE')) })
+    child.on('close', code => { clearTimeout(timer); code === 0 ? resolve(Buffer.concat(chunks)) : reject(new Error('BACKUP_DUMP_FAILED')) })
+  })
+  const result = await saveEncryptedBackup(directory, dump, key)
+  const pointer = process.env.FINNTECH_BACKUP_LAST_RECEIPT_FILE
+  if (pointer) {
+    if (!path.isAbsolute(pointer) || path.dirname(path.resolve(pointer)) !== path.resolve(directory)) throw new Error('BACKUP_PRIVATE_RECEIPT_REQUIRED')
+    await writeFile(pointer, JSON.stringify({ archivePath: result.file, createdAt: result.receipt.createdAt, status: result.receipt.status }), { mode: 0o600 })
+  }
+  console.log(JSON.stringify({ status: result.receipt.status, createdAt: result.receipt.createdAt, bytes: result.receipt.bytes,
+    fullRestore: 'NOT_TESTED', offDeviceCopy: 'NOT_CONFIRMED' }))
+} catch { console.error('FAIL: encrypted backup unavailable; details withheld; existing archives retained'); process.exitCode = 1 }
+finally { key?.fill(0); dump?.fill(0); await db.$disconnect() }
diff --git a/scripts/real-drive-backup-core.mjs b/scripts/real-drive-backup-core.mjs
new file mode 100644
index 0000000..5a7d4af
--- /dev/null
+++ b/scripts/real-drive-backup-core.mjs
@@ -0,0 +1,87 @@
+import { sha256, backupLimits } from './real-backup-core.mjs'
+
+const fileId = /^[A-Za-z0-9_-]{10,200}$/
+export class GoogleDriveBackups {
+  constructor(settings, transport = fetch) { this.settings = settings; this.transport = transport; this.token = undefined }
+  async responseBytes(response, maximum = 32768) {
+    const reader = response.body?.getReader(); if (!reader) throw new Error('DRIVE_RESPONSE_REJECTED')
+    const chunks = []; let size = 0
+    try { while (true) { const chunk = await reader.read(); if (chunk.done) break; size += chunk.value.length; if (size > maximum) throw new Error('DRIVE_RESPONSE_LIMIT'); chunks.push(chunk.value) } }
+    finally { void reader.cancel().catch(() => {}) }
+    return Buffer.concat(chunks)
+  }
+  async authenticate() {
+    const { clientId, clientSecret, refreshToken } = this.settings
+    if (!clientId || !clientSecret || !refreshToken) throw new Error('DRIVE_OWNER_AUTHORIZATION_REQUIRED')
+    try {
+      const response = await this.transport('https://oauth2.googleapis.com/token', { method: 'POST', redirect: 'error', signal: AbortSignal.timeout(5000),
+        headers: { 'content-type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ client_id: clientId, client_secret: clientSecret, refresh_token: refreshToken, grant_type: 'refresh_token' }).toString() })
+      if (!response.ok) throw new Error('refresh_failed')
+      const result = JSON.parse((await this.responseBytes(response)).toString('utf8'))
+      if (typeof result.access_token !== 'string' || !result.access_token) throw new Error('refresh_failed')
+      this.token = result.access_token
+    } catch { throw new Error('DRIVE_OWNER_AUTHORIZATION_REQUIRED') }
+  }
+  async api(endpoint, options = {}) {
+    if (!this.token) throw new Error('DRIVE_OWNER_AUTHORIZATION_REQUIRED')
+    const response = await this.transport(`https://www.googleapis.com/drive/v3/${endpoint}`, { ...options, redirect: 'error', signal: AbortSignal.timeout(10000), headers: { ...options.headers, authorization: `Bearer ${this.token}` } })
+    if (!response.ok) { void response.body?.cancel(); throw new Error('DRIVE_REQUEST_UNCONFIRMED') }
+    return JSON.parse((await this.responseBytes(response)).toString('utf8'))
+  }
+  async preflight(folder, bytes) {
+    if (!fileId.test(folder) || !Number.isSafeInteger(bytes) || bytes < 0 || bytes > backupLimits.maximum + 64) throw new Error('DRIVE_TARGET_REJECTED')
+    const info = await this.api(`files/${folder}?fields=id,mimeType,trashed,ownedByMe,shared,capabilities(canAddChildren)`)
+    if (info.id !== folder || info.mimeType !== 'application/vnd.google-apps.folder' || info.trashed || !info.ownedByMe || info.shared || !info.capabilities?.canAddChildren) throw new Error('DRIVE_PRIVATE_FOLDER_REQUIRED')
+    const about = await this.api('about?fields=storageQuota')
+    const quota = about.storageQuota
+    if (!/^\d+$/.test(quota?.limit ?? '') || !/^\d+$/.test(quota?.usage ?? '') || BigInt(quota.limit) - BigInt(quota.usage) < BigInt(bytes) + 1048576n) throw new Error('DRIVE_QUOTA_UNCONFIRMED_OR_FULL')
+    return { remainingBytes: (BigInt(quota.limit) - BigInt(quota.usage)).toString(), privateFolder: true }
+  }
+  async reserveId() {
+    const response = await this.api('files/generateIds?count=1&space=drive&type=files')
+    const id = response.ids?.[0]; if (typeof id !== 'string' || !fileId.test(id)) throw new Error('DRIVE_RESERVATION_FAILED')
+    return id
+  }
+  async download(id, maximum = backupLimits.maximum + 64) {
+    if (!this.token || !fileId.test(id)) throw new Error('DRIVE_TARGET_REJECTED')
+    const response = await this.transport(`https://www.googleapis.com/drive/v3/files/${id}?alt=media`, { redirect: 'error', signal: AbortSignal.timeout(120000), headers: { authorization: `Bearer ${this.token}` } })
+    if (!response.ok) { void response.body?.cancel(); throw new Error('DRIVE_DOWNLOAD_UNCONFIRMED') }
+    return this.responseBytes(response, maximum)
+  }
+  async publishReceipt(folder, id, receipt) {
+    if (!fileId.test(id) || !fileId.test(folder) || receipt.status !== 'ENCRYPTED_AND_VERIFIED' || !receipt.createdAt) throw new Error('DRIVE_RECEIPT_REJECTED')
+    const metadata = await this.api(`files/${id}?fields=id,parents,ownedByMe,shared,trashed,mimeType`)
+    if (metadata.id !== id || !metadata.ownedByMe || metadata.shared || metadata.trashed || metadata.mimeType !== 'application/json'
+      || metadata.parents?.length !== 1 || metadata.parents[0] !== folder) throw new Error('DRIVE_PRIVATE_RECEIPT_REQUIRED')
+    const bytes = Buffer.from(JSON.stringify({ status: receipt.status, createdAt: receipt.createdAt, encryptedSha256: receipt.encryptedSha256, offDeviceCopy: 'DOWNLOADED_AND_AUTHENTICATED', fullRestore: receipt.fullRestore }))
+    const response = await this.transport(`https://www.googleapis.com/upload/drive/v3/files/${id}?uploadType=media`, { method: 'PATCH', redirect: 'error', signal: AbortSignal.timeout(10000),
+      headers: { authorization: `Bearer ${this.token}`, 'content-type': 'application/json' }, body: bytes })
+    void response.body?.cancel()
+    if (!response.ok || !bytes.equals(await this.download(id, 4096))) throw new Error('DRIVE_RECEIPT_UNCONFIRMED')
+  }
+  async uploadEncrypted(folder, id, name, archive) {
+    const magic = Buffer.from('FINNTECH-BACKUP-1\n')
+    if (!fileId.test(id) || !/^[A-Za-z0-9TZ._-]+\.fnb$/.test(name) || !archive.subarray(0, magic.length).equals(magic)) throw new Error('DRIVE_ENCRYPTED_ARCHIVE_REQUIRED')
+    await this.preflight(folder, archive.length)
+    const hash = sha256(archive)
+    try {
+      const response = await this.transport('https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable&fields=id', { method: 'POST', redirect: 'error', signal: AbortSignal.timeout(10000),
+        headers: { authorization: `Bearer ${this.token}`, 'content-type': 'application/json', 'X-Upload-Content-Type': 'application/octet-stream', 'X-Upload-Content-Length': String(archive.length) },
+        body: JSON.stringify({ id, name, mimeType: 'application/octet-stream', parents: [folder], appProperties: { finntechFormat: backupLimits.format, encryptedSha256: hash } }) })
+      if (!response.ok) throw new Error('upload_unconfirmed')
+      const location = new URL(response.headers.get('location'))
+      void response.body?.cancel()
+      if (location.origin !== 'https://www.googleapis.com' || !location.pathname.startsWith('/upload/drive/v3/files')) throw new Error('upload_redirect_rejected')
+      const upload = await this.transport(location.href, { method: 'PUT', redirect: 'error', signal: AbortSignal.timeout(120000), headers: { authorization: `Bearer ${this.token}`, 'content-type': 'application/octet-stream' }, body: archive })
+      void upload.body?.cancel(); if (!upload.ok) throw new Error('upload_unconfirmed')
+    } catch {
+      // A lost upload response may still have committed. Check the reserved SAME file ID.
+      // The caller journals the ID before upload; reruns never invent another ID.
+    }
+    const metadata = await this.api(`files/${id}?fields=id,parents,ownedByMe,shared,trashed,appProperties`)
+    if (metadata.id !== id || !metadata.ownedByMe || metadata.shared || metadata.trashed || metadata.parents?.length !== 1 || metadata.parents[0] !== folder || metadata.appProperties?.encryptedSha256 !== hash) throw new Error('DRIVE_UPLOAD_UNCONFIRMED')
+    const downloaded = await this.download(id)
+    if (sha256(downloaded) !== hash) throw new Error('DRIVE_ROUND_TRIP_MISMATCH')
+    return { id, encryptedSha256: hash, downloadedBytes: downloaded.length }
+  }
+}
diff --git a/scripts/real-drive-backup-core.test.mjs b/scripts/real-drive-backup-core.test.mjs
new file mode 100644
index 0000000..017892f
--- /dev/null
+++ b/scripts/real-drive-backup-core.test.mjs
@@ -0,0 +1,63 @@
+import { test } from 'vitest'
+import assert from 'node:assert/strict'
+import { GoogleDriveBackups } from './real-drive-backup-core.mjs'
+import { encryptDump, sha256 } from './real-backup-core.mjs'
+import { randomBytes } from 'node:crypto'
+
+const folder = 'owner_folder_123', id = 'reserved_file_123', settings = { clientId: 'fixture', clientSecret: 'fixture-secret', refreshToken: 'fixture-refresh' }
+const json = value => new Response(JSON.stringify(value))
+function transport(archive, options = {}) {
+  const calls = []
+  const fetcher = async (url, request) => {
+    calls.push({ url, request })
+    if (url === 'https://oauth2.googleapis.com/token') return json({ access_token: 'fixture-access' })
+    if (url.includes(`files/${folder}?`)) return json({ id: folder, mimeType: 'application/vnd.google-apps.folder', ownedByMe: true, shared: !!options.shared, capabilities: { canAddChildren: true } })
+    if (url.includes('about?')) return json({ storageQuota: { limit: options.full ? '100' : '10000000', usage: '99' } })
+    if (url.includes('uploadType=resumable')) return new Response('{}', { headers: { location: 'https://www.googleapis.com/upload/drive/v3/files?upload_id=fixture' } })
+    if (url.includes('upload_id=')) { if (options.lost) throw new Error('fixture lost response'); return json({ id }) }
+    if (url.includes(`files/${id}?alt=media`)) return new Response(options.corrupt ? Buffer.from('corrupt') : archive)
+    if (url.includes(`files/${id}?fields`)) return json({ id, parents: [folder], ownedByMe: true, shared: false, appProperties: { encryptedSha256: sha256(archive) } })
+    throw new Error('unexpected fixture request')
+  }
+  return { fetcher, calls }
+}
+test('Drive backup refreshes owner authorization, checks actual quota/private folder and verifies downloaded ciphertext', async () => {
+  const archive = encryptDump(Buffer.from('PGDMPsynthetic-only'), randomBytes(32)), fixture = transport(archive), client = new GoogleDriveBackups(settings, fixture.fetcher)
+  await client.authenticate(); const result = await client.uploadEncrypted(folder, id, '20261008-test.fnb', archive)
+  assert.equal(result.id, id); assert.equal(result.encryptedSha256, sha256(archive))
+  const upload = fixture.calls.find(call => call.request?.method === 'PUT'); assert.deepEqual(upload.request.body, archive)
+  assert.ok(!upload.request.body.includes(Buffer.from('synthetic-only')))
+})
+test('lost upload response reconciles the same reserved file, without duplicate create or raw data upload', async () => {
+  const archive = encryptDump(Buffer.from('PGDMPfixture'), randomBytes(32)), fixture = transport(archive, { lost: true }), client = new GoogleDriveBackups(settings, fixture.fetcher)
+  await client.authenticate(); assert.equal((await client.uploadEncrypted(folder, id, '20261008-test.fnb', archive)).id, id)
+  assert.equal(fixture.calls.filter(call => call.url.includes('uploadType=resumable')).length, 1)
+  assert.equal(JSON.parse(fixture.calls.find(call => call.url.includes('uploadType=resumable')).request.body).id, id)
+})
+test('shared folder/quota and corrupted download never pass cloud backup verification', async () => {
+  for (const options of [{ shared: true }, { full: true }, { corrupt: true }]) {
+    const archive = encryptDump(Buffer.from('PGDMPfixture'), randomBytes(32)), fixture = transport(archive, options), client = new GoogleDriveBackups(settings, fixture.fetcher)
+    await client.authenticate(); await assert.rejects(client.uploadEncrypted(folder, id, '20261008-test.fnb', archive), new RegExp(options.shared ? 'DRIVE_PRIVATE_FOLDER_REQUIRED' : options.full ? 'DRIVE_QUOTA_UNCONFIRMED_OR_FULL' : 'DRIVE_ROUND_TRIP_MISMATCH'))
+  }
+})
+
+test('off-device receipt publication checks private ownership and round-trips only coarse evidence', async () => {
+  let stored
+  const receipt = { status: 'ENCRYPTED_AND_VERIFIED', createdAt: new Date().toISOString(), encryptedSha256: 'a'.repeat(64), fullRestore: 'NOT_TESTED', privateField: 'must-not-publish' }
+  const requests = []
+  const client = new GoogleDriveBackups(settings, async (url, request) => {
+    requests.push({ url, request })
+    if (url.includes('?fields=')) return json({ id, parents: [folder], ownedByMe: true, shared: false, mimeType: 'application/json' })
+    if (request.method === 'PATCH') { stored = request.body; return json({ id }) }
+    if (url.includes('alt=media')) return new Response(stored)
+    throw new Error('unexpected fixture request')
+  })
+  client.token = 'fixture-access'
+  await client.publishReceipt(folder, id, receipt)
+  assert.equal(JSON.parse(stored).offDeviceCopy, 'DOWNLOADED_AND_AUTHENTICATED')
+  assert.ok(!stored.includes(Buffer.from(receipt.privateField)))
+  assert.equal(requests.filter(call => call.request.method === 'PATCH').length, 1)
+  const denied = new GoogleDriveBackups(settings, async () => json({ id, parents: [folder], ownedByMe: true, shared: true, mimeType: 'application/json' }))
+  denied.token = 'fixture-access'
+  await assert.rejects(denied.publishReceipt(folder, id, receipt), /DRIVE_PRIVATE_RECEIPT_REQUIRED/)
+})
diff --git a/scripts/real-drive-backup.mjs b/scripts/real-drive-backup.mjs
new file mode 100644
index 0000000..162b53d
--- /dev/null
+++ b/scripts/real-drive-backup.mjs
@@ -0,0 +1,35 @@
+import { readFile, writeFile, lstat } from 'node:fs/promises'
+import path from 'node:path'
+import { GoogleDriveBackups } from './real-drive-backup-core.mjs'
+import { decryptDump, readBackupKey, sha256, backupLimits } from './real-backup-core.mjs'
+
+// Run by the owner outside the web service, after an encrypted local backup succeeds.
+const archivePath = process.env.FINNTECH_BACKUP_ARCHIVE ?? '', keyPath = process.env.FINNTECH_BACKUP_KEY_FILE ?? '', folder = process.env.FINNTECH_DRIVE_FOLDER_ID ?? ''
+if (!path.isAbsolute(archivePath) || !path.isAbsolute(keyPath) || !(await lstat(archivePath)).isFile() || (await lstat(archivePath)).isSymbolicLink()
+  || (await lstat(archivePath)).size > backupLimits.maximum + 64) throw new Error('PRIVATE_ARCHIVE_REQUIRED')
+const client = new GoogleDriveBackups({ clientId: process.env.FINNTECH_DRIVE_CLIENT_ID, clientSecret: process.env.FINNTECH_DRIVE_CLIENT_SECRET, refreshToken: process.env.FINNTECH_DRIVE_REFRESH_TOKEN })
+let key, dump
+try {
+  const archive = await readFile(archivePath), receipt = JSON.parse(await readFile(`${archivePath}.json`, 'utf8'))
+  if (receipt.format !== backupLimits.format || receipt.status !== 'ENCRYPTED_AND_VERIFIED' || receipt.encryptedSha256 !== sha256(archive)) throw new Error('ARCHIVE_RECEIPT_MISMATCH')
+  key = await readBackupKey(keyPath); dump = decryptDump(archive, key)
+  if (sha256(dump) !== receipt.dumpSha256) throw new Error('ARCHIVE_AUTHENTICATION_FAILED')
+  await client.authenticate(); const quota = await client.preflight(folder, archive.length)
+  const journalPath = `${archivePath}.drive.json`
+  let journal
+  try { journal = JSON.parse(await readFile(journalPath, 'utf8')) } catch (error) {
+    if (error.code !== 'ENOENT') throw error
+    journal = { folder, id: await client.reserveId(), encryptedSha256: receipt.encryptedSha256, status: 'RESERVED' }
+    // Persist before upload; a timeout reuses this file ID, never creates a replacement.
+    await writeFile(journalPath, JSON.stringify(journal), { flag: 'wx', mode: 0o600 })
+  }
+  if (journal.folder !== folder || journal.encryptedSha256 !== receipt.encryptedSha256) throw new Error('ORIGINAL_UPLOAD_JOURNAL_REQUIRED')
+  const result = await client.uploadEncrypted(folder, journal.id, path.basename(archivePath), archive)
+  const downloaded = await client.download(result.id), decoded = decryptDump(downloaded, key)
+  if (sha256(decoded) !== receipt.dumpSha256) throw new Error('DRIVE_DECRYPTED_COPY_MISMATCH')
+  decoded.fill(0)
+  await writeFile(journalPath, JSON.stringify({ ...journal, status: 'DOWNLOADED_AND_AUTHENTICATED', verifiedAt: new Date().toISOString(), remainingBytes: quota.remainingBytes }), { mode: 0o600 })
+  if (process.env.FINNTECH_DRIVE_RECEIPT_FILE_ID) await client.publishReceipt(folder, process.env.FINNTECH_DRIVE_RECEIPT_FILE_ID, receipt)
+  console.log('PASS: private Drive folder/quota checked, ciphertext uploaded/downloaded and authenticated; full cloud-source restore and schedule still require acceptance')
+} catch { console.error('FAIL: Drive backup unconfirmed; original archive and upload journal retained; details withheld'); process.exitCode = 1 }
+finally { key?.fill(0); dump?.fill(0); client.token = undefined }
diff --git a/scripts/real-migration-rehearsal.mjs b/scripts/real-migration-rehearsal.mjs
