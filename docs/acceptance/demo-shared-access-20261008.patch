diff --git a/apps/api/prisma/schema.prisma b/apps/api/prisma/schema.prisma
index fb34882..3f33b45 100644
--- a/apps/api/prisma/schema.prisma
+++ b/apps/api/prisma/schema.prisma
@@ -121,9 +121,22 @@ model AuthUser {
   identity AuthIdentity?
   recovery AuthRecoveryEnrollment?
   deliveryJobs AuthDeliveryJob[]
+  demoWorkspace DemoWorkspace?
   @@map("auth_users")
 }
 
+// Durable browser request receipt. No demo password store and no automatic retention deletion.
+model DemoWorkspace {
+  requestHash String @id @map("request_hash") @db.Char(64)
+  userId String @unique @map("user_id") @db.Uuid
+  user AuthUser @relation(fields: [userId], references: [id], onDelete: Restrict)
+  sessionId String @unique @map("session_id") @db.Uuid
+  epoch String @db.VarChar(64)
+  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
+  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
+  @@map("demo_workspaces")
+}
+
 model AuthSession {
   id String @id @default(uuid()) @db.Uuid
   expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

