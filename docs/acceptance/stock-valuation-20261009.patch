+   <label className="auth-label">รายการอ้างอิง<select className="auth-input" disabled={disabled} value={symbol} onChange={e=>choose(e.target.value)}><option value="USDTHB">USD → THB</option>{STOCK_INSTRUMENTS.map(r=><option key={r.symbol} value={r.symbol}>{r.symbol}</option>)}</select></label>
+   <label className="auth-label">{symbol==='USDTHB'?'อัตรา THB ต่อ 1 USD':'ราคา USD ต่อหุ้น'}<input ref={input} className="auth-input" inputMode="decimal" required disabled={disabled} value={value} onChange={e=>setValue(e.target.value)}/></label>
+   <label className="auth-label">วันและเวลาอ้างอิง<input className="auth-input" type="datetime-local" required disabled={disabled} value={asOf} onChange={e=>setAsOf(e.target.value)}/></label>
+   <label className="flex items-center gap-2 text-sm"><input type="checkbox" checked={enabled} disabled={disabled} onChange={e=>setEnabled(e.target.checked)}/>ใช้ค่าที่กรอกแทนอัตโนมัติ</label>
+   <button className="auth-primary" disabled={disabled}>บันทึกราคา / อัตราอ้างอิง</button>
+  </form>{write.message&&<p role="alert">{write.message}</p>}{write.pending&&<div><p role="status">ยังไม่ทราบผลราคาอ้างอิง เมนูพักอยู่ ตรวจผลด้วย payload และ key เดิม</p><button className="auth-primary mt-3" disabled={write.busy} onClick={write.retry}>ตรวจผลราคาอ้างอิงด้วยคำขอเดิม</button></div>}
+ </section>
+}
diff --git a/apps/web/src/tracker/valuationPolicy.test.ts b/apps/web/src/tracker/valuationPolicy.test.ts
new file mode 100644
index 0000000..4eec7bf
--- /dev/null
+++ b/apps/web/src/tracker/valuationPolicy.test.ts
@@ -0,0 +1,33 @@
+import {it,expect} from 'vitest'
+import type {ValuationOverview,StockMarketSnapshot} from '@finntech/contracts'
+import {selectReference,REFERENCE_MAX_AGE} from './valuationPolicy'
+import {valueMixedAssets,valueAssets} from '@finntech/finance'
+const now=Date.parse('2026-10-09T12:00:00.000Z'),asOf=new Date(now).toISOString()
+const data:ValuationOverview={references:[],usdThb:{source:'ECB',kind:'DAILY',status:'DAILY',rate:'35',asOf,receivedAt:asOf}}
+const market:StockMarketSnapshot={source:'Alpaca IEX',currency:'USD',connection:'STREAMING',quotes:[{symbol:'AAPL',price:'120',status:'LIVE',observedAt:asOf,receivedAt:asOf}]}
+it('manual override is visible, reversible, bounded by observation age and never substitutes purchase cost',()=>{
+ const manual={id:'00000000-0000-4000-8000-000000000001',version:1,symbol:'AAPL',currency:'USD' as const,source:'MANUAL' as const,value:'130',asOf,updatedAt:asOf,enabled:true}
+ const override={...data,references:[manual]}
+ expect(selectReference('AAPL',override,market,now)).toMatchObject({value:'130',state:'MANUAL'})
+ expect(selectReference('AAPL',{...data,references:[{...manual,enabled:false}]},market,now).value).toBe('120')
+ expect(selectReference('AAPL',override,market,now+REFERENCE_MAX_AGE+1)).toMatchObject({value:null,state:'STALE'})
+ expect(selectReference('AAPL',{...data,references:[{...manual,asOf:new Date(now-REFERENCE_MAX_AGE-1).toISOString()}]},market,now).value).toBeNull()
+ expect(selectReference('AAPL',null,null,now)).toMatchObject({value:null,state:'MISSING'})
+ expect(selectReference('AAPL',data,market,now+30001)).toMatchObject({value:null,state:'STALE'})
+ expect(selectReference('AAPL',data,market,now-1).value).toBeNull()
+})
+it('USD daily/manual policy is separate from live rates, and errors need explicit fallback',()=>{
+ expect(selectReference('USDTHB',data,null,now+30001)).toMatchObject({value:'35',state:'DAILY'})
+ expect(selectReference('USDTHB',{...data,usdThb:{...data.usdThb,status:'ERROR'}},null,now)).toMatchObject({value:null,state:'ERROR'})
+ expect(selectReference('USDTHB',data,null,now+REFERENCE_MAX_AGE+1).value).toBeNull()
+ const manual={id:'00000000-0000-4000-8000-000000000002',version:1,symbol:'USDTHB',currency:'THB' as const,source:'MANUAL' as const,value:'36',asOf,updatedAt:asOf,enabled:true}
+ expect(selectReference('USDTHB',{...data,references:[manual]},null,now)).toMatchObject({value:'36',state:'MANUAL'})
+})
+it('fractional shares in different portfolios aggregate once; missing quote differs from missing FX and zero needs neither',()=>{
+ const base=valueAssets(['100'],[{portfolioId:'c',asset:'BTC',quantity:'0.1'}],new Map([['BTC','20']]),'34')
+ const holdings=[{portfolioId:'a',symbol:'AAPL',quantity:'0.5'},{portfolioId:'b',symbol:'AAPL',quantity:'0.25'}],prices=new Map([['AAPL','120']]),manual=[{currency:'THB' as const,value:'10'},{currency:'USD' as const,value:'5'},{currency:'USDT' as const,value:'1'}]
+ expect(valueMixedAssets(base,holdings,prices,manual,'34','35')).toMatchObject({totalThb:'3537',complete:true,native:{USD:'95'}})
+ expect(valueMixedAssets(base,holdings,prices,manual,'34',null)).toMatchObject({totalThb:null,knownThb:'212',native:{USD:'95'}})
+ expect(valueMixedAssets(base,holdings,new Map(),manual,'34','35')).toMatchObject({totalThb:null,knownThb:'387',native:{USD:null},knownNative:{USD:'5'}})
+ expect(valueMixedAssets(valueAssets([],[],new Map(),null),[{symbol:'AAPL',quantity:'0'}],new Map(),[],null,null)).toMatchObject({complete:true,totalThb:'0'})
+})
diff --git a/apps/web/src/tracker/valuationPolicy.ts b/apps/web/src/tracker/valuationPolicy.ts
new file mode 100644
index 0000000..47e1a92
--- /dev/null
+++ b/apps/web/src/tracker/valuationPolicy.ts
@@ -0,0 +1,17 @@
+import type { ValuationOverview, StockMarketSnapshot } from '@finntech/contracts'
+export const REFERENCE_MAX_AGE=7*86400000
+export type SelectedReference={value:string|null;source:string;asOf:string|null;state:'LIVE'|'DAILY'|'MANUAL'|'STALE'|'MISSING'|'ERROR'}
+const valid=(date:string|null,now:number,limit:number)=>date!==null&&now-Date.parse(date)>=0&&now-Date.parse(date)<=limit
+/** An enabled manual override wins, including when stale. Disable it explicitly to resume automatic. */
+export function selectReference(symbol:string, overview:ValuationOverview|null,market:StockMarketSnapshot|null,now:number):SelectedReference {
+ const manual=overview?.references.find(r=>r.symbol===symbol&&r.enabled)
+ if(manual)return {value:valid(manual.asOf,now,REFERENCE_MAX_AGE)?manual.value:null,source:'กรอกเอง (แทนอัตโนมัติ)',asOf:manual.asOf,state:valid(manual.asOf,now,REFERENCE_MAX_AGE)?'MANUAL':'STALE'}
+ if(symbol==='USDTHB'){
+  const fx=overview?.usdThb
+  if(fx?.status==='DAILY'&&valid(fx.asOf,now,REFERENCE_MAX_AGE)&&fx.rate)return {value:fx.rate,source:'ECB · อ้างอิงรายวัน (THB/EUR ÷ USD/EUR)',asOf:fx.asOf,state:'DAILY'}
+  return {value:null,source:'ECB · อ้างอิงรายวัน',asOf:fx?.asOf??null,state:fx?.status==='ERROR'?'ERROR':fx?.asOf?'STALE':'MISSING'}
+ }
+ const q=market?.quotes.find(q=>q.symbol===symbol)
+ if(q?.status==='LIVE'&&q.price&&valid(q.observedAt??null,now,30000)&&valid(q.receivedAt,now,30000))return {value:q.price,source:market!.source,asOf:q.observedAt!,state:'LIVE'}
+ return {value:null,source:market?.source??'ยังไม่มี feed ที่อนุญาต',asOf:q?.observedAt??null,state:q?.price?'STALE':q?.status==='UNAVAILABLE'?'ERROR':'MISSING'}
+}
